<Window
    x:Class="NotePadApp.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:avalonEdit="http://icsharpcode.net/sharpdevelop/avalonedit"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:NotePadApp"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:svgc="http://sharpvectors.codeplex.com/svgc/"
    Title="Notepad"
    Width="1000"
    Height="600"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Rectangle Fill="#F0F0F0" />
        <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
            <Grid Margin="10,0,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>

                <Button
                    x:Name="BtnUndo"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="BtnUndo_Click"
                    Focusable="False">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                    <svgc:SvgViewbox
                        Width="20"
                        Height="20"
                        Source="Core/Resources/Images/undo-icon.svg"
                        Stretch="Uniform" />
                </Button>

                <Button
                    x:Name="BtnRedo"
                    Grid.Column="1"
                    Margin="20,0,0,0"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="BtnRedo_Click"
                    Focusable="False">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                    <svgc:SvgViewbox
                        Width="20"
                        Height="20"
                        Source="Core/Resources/Images/redo-icon.svg"
                        Stretch="Uniform" />
                </Button>
            </Grid>
            <Separator
                Height="20"
                Margin="10,0,0,0"
                Background="Gray">
                <Separator.LayoutTransform>
                    <RotateTransform Angle="90" />
                </Separator.LayoutTransform>
            </Separator>
            <Grid Margin="10,0,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>

                <Button
                    x:Name="BtnBold"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="BtnBold_Click"
                    Focusable="False">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                    <svgc:SvgViewbox
                        Width="20"
                        Height="20"
                        Source="Core/Resources/Images/bold-icon.svg"
                        Stretch="Uniform" />
                </Button>

                <Button
                    x:Name="BtnItalic"
                    Grid.Column="1"
                    Margin="20,0,0,0"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="BtnItalic_Click"
                    Focusable="False">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                    <svgc:SvgViewbox
                        Width="20"
                        Height="20"
                        Source="Core/Resources/Images/italic-icon.svg"
                        Stretch="Uniform" />
                </Button>

                <Button
                    x:Name="BtnUnderline"
                    Grid.Column="2"
                    Margin="20,0,0,0"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="BtnUnderline_Click"
                    Focusable="False">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                    <svgc:SvgViewbox
                        Width="20"
                        Height="20"
                        Source="Core/Resources/Images/underline-icon.svg"
                        Stretch="Uniform" />
                </Button>

                <Button
                    x:Name="BtnStrikethrough"
                    Grid.Column="3"
                    Margin="20,0,0,0"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="BtnStrikethrough_Click"
                    Focusable="False">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                    <svgc:SvgViewbox
                        Width="20"
                        Height="20"
                        Source="Core/Resources/Images/snakethrough-icon.svg"
                        Stretch="Uniform" />
                </Button>

                <Button
                    x:Name="BtnSubscript"
                    Grid.Column="4"
                    Margin="20,0,0,0"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="BtnSubscript_Click"
                    Focusable="False">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                    <svgc:SvgViewbox
                        Width="20"
                        Height="20"
                        Source="Core/Resources/Images/low-index-icon.svg"
                        Stretch="Uniform" />
                </Button>

                <Button
                    x:Name="BtnSuperscript"
                    Grid.Column="5"
                    Margin="20,0,0,0"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="BtnSuperscript_Click"
                    Focusable="False">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                    <svgc:SvgViewbox
                        Width="20"
                        Height="20"
                        Source="Core/Resources/Images/high-index-icon.svg"
                        Stretch="Uniform" />
                </Button>
            </Grid>
            <Separator
                Height="20"
                Margin="10,0,0,0"
                Background="Gray">
                <Separator.LayoutTransform>
                    <RotateTransform Angle="90" />
                </Separator.LayoutTransform>
            </Separator>
            <Grid Margin="10,0,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>

                <Button
                    x:Name="BtnNewFile"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="BtnNewFile_Click"
                    Focusable="False">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                    <svgc:SvgViewbox
                        Width="20"
                        Height="20"
                        Source="Core/Resources/Images/new-file-icon.svg"
                        Stretch="Uniform" />
                </Button>

                <Button
                    x:Name="BtnOpenFile"
                    Grid.Column="1"
                    Margin="20,0,0,0"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="BtnOpenFile_Click"
                    Focusable="False">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                    <svgc:SvgViewbox
                        Width="20"
                        Height="20"
                        Source="Core/Resources/Images/load-file-icon.svg"
                        Stretch="Uniform" />
                </Button>

                <Button
                    x:Name="BtnSaveFile"
                    Grid.Column="2"
                    Margin="20,0,0,0"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="BtnSaveFile_Click"
                    Focusable="False">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                    <svgc:SvgViewbox
                        Width="20"
                        Height="20"
                        Source="Core/Resources/Images/save-file-icon.svg"
                        Stretch="Uniform" />
                </Button>

                <Button
                    x:Name="BtnPrintFile"
                    Grid.Column="3"
                    Margin="20,0,0,0"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="BtnPrintFile_Click"
                    Focusable="False">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                    <svgc:SvgViewbox
                        Width="20"
                        Height="20"
                        Source="Core/Resources/Images/print-icon.svg"
                        Stretch="Uniform" />
                </Button>
            </Grid>
        </StackPanel>

        <!--  Библиотека с NuGet позволяющая создать текстовый редактор  -->
        <avalonEdit:TextEditor
            x:Name="TextEditor"
            Grid.Row="1"
            FontSize="16"
            ShowLineNumbers="True"
            TextChanged="TextEditor_TextChanged" />

    </Grid>
</Window>
