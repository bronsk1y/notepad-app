<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Core\Resources\Images\bold-icon.svg" />
    <None Remove="Core\Resources\Images\high-index-icon.svg" />
    <None Remove="Core\Resources\Images\italic-icon.svg" />
    <None Remove="Core\Resources\Images\load-file-icon.svg" />
    <None Remove="Core\Resources\Images\low-index-icon.svg" />
    <None Remove="Core\Resources\Images\new-file-icon.svg" />
    <None Remove="Core\Resources\Images\print-icon.svg" />
    <None Remove="Core\Resources\Images\redo-icon.svg" />
    <None Remove="Core\Resources\Images\save-file-icon.svg" />
    <None Remove="Core\Resources\Images\snakethrough-icon.svg" />
    <None Remove="Core\Resources\Images\underline-icon.svg" />
    <None Remove="Core\Resources\Images\undo-icon.svg" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AvalonEdit" Version="6.3.1.120" />
    <PackageReference Include="SharpVectors.Wpf" Version="1.8.5" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Core\Resources\Images\bold-icon.svg">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Resource>
    <Resource Include="Core\Resources\Images\high-index-icon.svg">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Resource>
    <Resource Include="Core\Resources\Images\italic-icon.svg">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Resource>
    <Resource Include="Core\Resources\Images\load-file-icon.svg">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Resource>
    <Resource Include="Core\Resources\Images\low-index-icon.svg">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Resource>
    <Resource Include="Core\Resources\Images\new-file-icon.svg">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Resource>
    <Resource Include="Core\Resources\Images\print-icon.svg">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Resource>
    <Resource Include="Core\Resources\Images\redo-icon.svg">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Resource>
    <Resource Include="Core\Resources\Images\save-file-icon.svg">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Resource>
    <Resource Include="Core\Resources\Images\snakethrough-icon.svg">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Resource>
    <Resource Include="Core\Resources\Images\underline-icon.svg">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Resource>
    <Resource Include="Core\Resources\Images\undo-icon.svg">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Resource>
  </ItemGroup>

</Project>
